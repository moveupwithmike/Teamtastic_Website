{
  "name": "temp_next_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --project tsconfig.strict.json --noEmit",
    "typecheck:edge": "deno check --no-lock --node-modules-dir=none supabase/functions/*/index.ts",
    "test": "vitest run",
    "test:edge": "deno test --allow-env supabase/tests/*-test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "^2.106.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "jimp": "^1.6.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "posthog-js": "^1.417.0",
    "posthog-node": "^5.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
